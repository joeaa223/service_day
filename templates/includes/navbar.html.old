<nav class="bg-white shadow-sm border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-16">

      <!-- Left: Brand -->
      <div class="flex items-center space-x-6">
        <span class="text-lg font-semibold text-gray-800">
          Service Day
        </span>

        {% if user.is_authenticated %}
        {% if user.is_staff %}
        <a href="{% url 'admin_dashboard' %}" class="text-sm text-gray-600 hover:text-blue-600 transition">
          Admin Dashboard
        </a>
        <a href="{% url 'sample_admin' %}" 
        class="text-sm text-gray-600 hover:text-blue-600 transition">
          Admin Sample
        </a>
        <a href="{% url 'broadcast_test' %}"
        class="text-sm text-gray-600 hover:text-blue-600 transition">
       Broadcast Test
     </a>
        {% else %}
        <a href="{% url 'user_dashboard' %}" class="text-sm text-gray-600 hover:text-blue-600 transition">
          Dashboard
        </a>
        <a href="{% url 'sample' %}" class="text-sm text-gray-600 hover:text-blue-600 transition">
          Sample
        </a>
        {% endif %}
        {% endif %}
      </div>

      <!-- Right: User / Auth -->
      <div class="flex items-center space-x-4">

        {% if user.is_authenticated %}
        <span id="notif-badge" style="display:inline-block;">0</span>
        <a href="{% url 'notifications:list' %}"
          class="relative inline-flex items-center text-gray-600 hover:text-blue-600">

          🔔

          {% if notification_count > 0 %}
          <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full px-2">
            {{ notification_count }}
          </span>
          {% endif %}
        </a>
        <span class="text-sm text-gray-500 hidden sm:block">
          Hello, {{ user.username }}
        </span>

        <form action="{% url 'logout' %}" method="post">
          {% csrf_token %}
          <button type="submit"
            class="text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg transition">
            Logout
          </button>
        </form>

        {% else %}
        <a href="{% url 'login' %}"
          class="text-sm bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition">
          Login
        </a>
        {% endif %}

      </div>
    </div>
  </div>
</nav>