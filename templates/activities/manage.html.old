{% extends "base.html" %}

{% block content %}
<div class="min-h-screen bg-white">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">

    <!-- Top -->
    <div class="border-b border-slate-200 pb-8">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Activity</p>
          <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
            Food Basket Distribution
          </h1>
          <p class="mt-4 text-sm leading-6 text-slate-600">
            Help prepare and distribute food baskets to low-income families in the surrounding area.
            Volunteers will assist with registration, packing, sorting, and distribution coordination.
          </p>

          <div class="mt-5 flex flex-wrap gap-2">
            <span class="rounded-full border border-slate-200 px-3 py-1 text-xs font-medium text-slate-600">
              Community
            </span>
            <span class="rounded-full border border-slate-200 px-3 py-1 text-xs font-medium text-slate-600">
              Subang Jaya
            </span>
            <span class="rounded-full border border-emerald-200 px-3 py-1 text-xs font-medium text-emerald-700">
              Available
            </span>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          {% if user.is_staff %}
            <a href="#"
               class="inline-flex items-center rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
              Edit
            </a>
            <button
              class="inline-flex items-center rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
              Disable
            </button>
            <button
              class="inline-flex items-center rounded-xl border border-rose-200 px-4 py-2.5 text-sm font-medium text-rose-600 hover:bg-rose-50">
              Delete
            </button>
          {% else %}
            <button
              class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800">
              Join Activity
            </button>
            <button
              class="inline-flex items-center rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
              Withdraw
            </button>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-3">

      <!-- Main -->
      <div class="space-y-10 lg:col-span-2">

        <!-- Key Info -->
        <section>
          <div class="mb-4">
            <h2 class="text-lg font-semibold text-slate-900">Overview</h2>
            <p class="mt-1 text-sm text-slate-500">Basic activity information and schedule</p>
          </div>

          <div class="grid grid-cols-1 gap-x-8 gap-y-6 border border-slate-200 rounded-2xl p-6 sm:grid-cols-2">
            <div>
              <p class="text-xs uppercase tracking-wide text-slate-400">Event date</p>
              <p class="mt-2 text-sm font-medium text-slate-900">20 Mar 2026</p>
            </div>

            <div>
              <p class="text-xs uppercase tracking-wide text-slate-400">Time</p>
              <p class="mt-2 text-sm font-medium text-slate-900">09:00 AM — 01:00 PM</p>
            </div>

            <div>
              <p class="text-xs uppercase tracking-wide text-slate-400">Cutoff date</p>
              <p class="mt-2 text-sm font-medium text-slate-900">18 Mar 2026, 11:59 PM</p>
            </div>

            <div>
              <p class="text-xs uppercase tracking-wide text-slate-400">Capacity</p>
              <p class="mt-2 text-sm font-medium text-slate-900">20 volunteers</p>
            </div>

            <div>
              <p class="text-xs uppercase tracking-wide text-slate-400">Joined</p>
              <p class="mt-2 text-sm font-medium text-slate-900">18 participants</p>
            </div>

            <div>
              <p class="text-xs uppercase tracking-wide text-slate-400">Coordinator</p>
              <p class="mt-2 text-sm font-medium text-slate-900">Nur Iman</p>
            </div>
          </div>
        </section>

        <!-- Description -->
        <section>
          <div class="mb-4">
            <h2 class="text-lg font-semibold text-slate-900">Description</h2>
            <p class="mt-1 text-sm text-slate-500">What volunteers will do during the activity</p>
          </div>

          <div class="rounded-2xl border border-slate-200 p-6">
            <p class="text-sm leading-7 text-slate-600">
              This activity focuses on preparing and distributing food baskets to selected families in the nearby
              community. Volunteers will help sort supplies, pack items into baskets, support registration, and
              coordinate simple handover tasks with the NGO team onsite.
            </p>

            <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <p class="text-xs uppercase tracking-wide text-slate-400">CSR type</p>
                <p class="mt-2 text-sm font-medium text-slate-900">Community</p>
              </div>

              <div>
                <p class="text-xs uppercase tracking-wide text-slate-400">NGO partner</p>
                <p class="mt-2 text-sm font-medium text-slate-900">Helping Hands NGO</p>
              </div>

              <div>
                <p class="text-xs uppercase tracking-wide text-slate-400">Dress code</p>
                <p class="mt-2 text-sm font-medium text-slate-900">Casual</p>
              </div>

              <div>
                <p class="text-xs uppercase tracking-wide text-slate-400">Transport</p>
                <p class="mt-2 text-sm font-medium text-slate-900">Self-arranged</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Venue -->
        <section>
          <div class="mb-4">
            <h2 class="text-lg font-semibold text-slate-900">Venue</h2>
            <p class="mt-1 text-sm text-slate-500">Location and address details</p>
          </div>

          <div class="rounded-2xl border border-slate-200 p-6">
            <p class="text-sm font-medium text-slate-900">Community Hall 2</p>
            <p class="mt-2 text-sm leading-7 text-slate-600">
              Jalan SS15/8A, Subang Jaya, Selangor, Malaysia
            </p>

            <div class="mt-6 border-t border-slate-200 pt-6">
              <p class="text-xs uppercase tracking-wide text-slate-400">Remarks</p>
              <p class="mt-2 text-sm leading-7 text-slate-600">
                Please arrive at least 15 minutes earlier for registration and briefing. Light refreshments
                will be provided during the session.
              </p>
            </div>
          </div>
        </section>

        <!-- Gallery -->
        <section x-data="{ preview: 'https://placehold.co/1200x700' }">
          <div class="mb-4 flex items-end justify-between gap-4">
            <div>
              <h2 class="text-lg font-semibold text-slate-900">Gallery</h2>
              <p class="mt-1 text-sm text-slate-500">Activity photos and updates</p>
            </div>
            <p class="text-sm text-slate-400">6 photos</p>
          </div>

          {% if user.is_staff %}
            <div class="mb-5 rounded-2xl border border-dashed border-slate-300 p-5">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="text-sm font-medium text-slate-900">Upload new photos</p>
                  <p class="mt-1 text-sm text-slate-500">Admin upload area for gallery images</p>
                </div>

                <div class="flex flex-wrap gap-3">
                  <label class="inline-flex cursor-pointer items-center rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
                    <input type="file" class="hidden" multiple>
                    Choose Files
                  </label>
                  <button class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800">
                    Upload
                  </button>
                </div>
              </div>
            </div>
          {% endif %}

          <div class="overflow-hidden rounded-3xl border border-slate-200 bg-slate-100">
            <img :src="preview" alt="Preview" class="h-[320px] w-full object-cover sm:h-[420px]">
          </div>

          <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3">
            <button @click="preview = 'https://placehold.co/1200x700?text=Photo+1'" class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100">
              <img src="https://placehold.co/600x400?text=Photo+1" alt="Photo 1" class="h-28 w-full object-cover">
            </button>

            <button @click="preview = 'https://placehold.co/1200x700?text=Photo+2'" class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100">
              <img src="https://placehold.co/600x400?text=Photo+2" alt="Photo 2" class="h-28 w-full object-cover">
            </button>

            <button @click="preview = 'https://placehold.co/1200x700?text=Photo+3'" class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100">
              <img src="https://placehold.co/600x400?text=Photo+3" alt="Photo 3" class="h-28 w-full object-cover">
            </button>

            <button @click="preview = 'https://placehold.co/1200x700?text=Photo+4'" class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100">
              <img src="https://placehold.co/600x400?text=Photo+4" alt="Photo 4" class="h-28 w-full object-cover">
            </button>

            <button @click="preview = 'https://placehold.co/1200x700?text=Photo+5'" class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100">
              <img src="https://placehold.co/600x400?text=Photo+5" alt="Photo 5" class="h-28 w-full object-cover">
            </button>

            <button @click="preview = 'https://placehold.co/1200x700?text=Photo+6'" class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100">
              <img src="https://placehold.co/600x400?text=Photo+6" alt="Photo 6" class="h-28 w-full object-cover">
            </button>
          </div>
        </section>

      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">

        <section class="rounded-2xl border border-slate-200 p-6">
          <h2 class="text-base font-semibold text-slate-900">Quick facts</h2>

          <dl class="mt-5 space-y-4">
            <div class="flex items-start justify-between gap-4">
              <dt class="text-sm text-slate-500">Status</dt>
              <dd class="text-sm font-medium text-slate-900">Available</dd>
            </div>

            <div class="flex items-start justify-between gap-4">
              <dt class="text-sm text-slate-500">District</dt>
              <dd class="text-sm font-medium text-slate-900">Subang Jaya</dd>
            </div>

            <div class="flex items-start justify-between gap-4">
              <dt class="text-sm text-slate-500">Remaining slots</dt>
              <dd class="text-sm font-medium text-slate-900">2</dd>
            </div>

            <div class="flex items-start justify-between gap-4">
              <dt class="text-sm text-slate-500">Cutoff</dt>
              <dd class="text-sm font-medium text-slate-900">18 Mar 2026</dd>
            </div>
          </dl>
        </section>

        <section class="rounded-2xl border border-slate-200 p-6">
          <h2 class="text-base font-semibold text-slate-900">Notes</h2>
          <div class="mt-4 space-y-4 text-sm leading-6 text-slate-600">
            <p>
              Volunteers are encouraged to arrive early for registration and briefing.
            </p>
            <p>
              Gallery images can be managed by admin from the upload section above.
            </p>
          </div>
        </section>

        {% if user.is_staff %}
          <section class="rounded-2xl border border-slate-200 p-6">
            <h2 class="text-base font-semibold text-slate-900">Admin tools</h2>
            <div class="mt-4 space-y-3">
              <button class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-left text-sm font-medium text-slate-700 hover:bg-slate-50">
                Manage participants
              </button>
              <button class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-left text-sm font-medium text-slate-700 hover:bg-slate-50">
                Update gallery
              </button>
              <button class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-left text-sm font-medium text-slate-700 hover:bg-slate-50">
                Edit schedule
              </button>
            </div>
          </section>
        {% endif %}

      </aside>
    </div>
  </div>
</div>
{% endblock %}